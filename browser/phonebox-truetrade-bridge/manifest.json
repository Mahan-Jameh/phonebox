{
  "manifest_version": 3,
  "name": "PhoneBox TrueTrade Bridge",
  "version": "0.1.0",
  "description": "Share and control the TrueTrade tab you select through the local PhoneBox Agent.",
  "minimum_chrome_version": "118",
  "key": "",
  "background": {"service_worker": "bridge.js"},
  "action": {"default_popup": "popup.html", "default_title": "PhoneBox TrueTrade"},
  "permissions": ["debugger", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"]
}
